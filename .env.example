# Database (Replit provides these automatically)
DATABASE_URL=postgresql://user:password@host:5432/dbname

# JWT
JWT_SECRET=your-super-secret-jwt-key-min-32-chars
JWT_EXPIRES_IN=7d

# Server
PORT=3001
NODE_ENV=development
FRONTEND_URL=http://localhost:5000

# Redis (optional - falls back to in-memory queue)
REDIS_URL=redis://localhost:6379

# File Storage (local uploads or S3-compatible)
STORAGE_TYPE=local
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=5

# S3/R2 (set STORAGE_TYPE=s3 to enable)
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=auto

# WhatsApp (optional)
WHATSAPP_API_URL=
WHATSAPP_API_TOKEN=

# Session
SESSION_SECRET=your-session-secret
